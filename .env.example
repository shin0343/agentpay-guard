# Keep mock for the offline frontend; set live after completing server setup.
NEXT_PUBLIC_API_MODE=mock
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://localhost:5432/agentpay_guard
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Demo sign-in and scenarios are off by default. Use private, distinct passcodes.
DEMO_MODE=false
DEMO_PASSCODES=
# Only the hash is persisted. Format: agk_test_ followed by exactly 32 ASCII key characters.
# Research agent bootstrap credential; seed once against a fresh database.
DEMO_AGENT_KEY=
# Enable only behind an ingress that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Copy SANDBOX credentials from the sandbox REST application in PayPal Developer Dashboard.
# The endpoint is pinned and any other value is rejected.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox BUSINESS account merchant ID (not email, payer ID or REST client ID).
PAYPAL_MERCHANT_ID=
# Optional public HTTPS webhook subscription. Without this, use reconciliation.
PAYPAL_WEBHOOK_ID=

# openai = actual API inference; fixture = simulated (requires DEMO_MODE=true).
# unavailable, missing credentials or any provider failure requires human review.
RISK_PROVIDER=unavailable
OPENAI_API_KEY=
# Pin a structured-output-capable model available to your account.
OPENAI_RISK_MODEL=gpt-4o-mini-2024-07-18

# Separate opt-in DB concurrency suite. Use a dedicated disposable migrated database.
TEST_DATABASE_URL=
